{
  "name": "eldenring-savegame-analyzer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Read-only, privacy-first Elden Ring PC save analyzer with semantic and AI-ready exports.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "lucide-react": "1.25.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ssh2": "1.17.0"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/ssh2": "1.15.5",
    "@vitejs/plugin-react": "6.0.3",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "npm@10.9.2"
}
